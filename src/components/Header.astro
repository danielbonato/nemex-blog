---
import { SITE_TITLE } from '../consts';
---
<header class="agenda-header">
	<div class="agenda-header-container">
		<a class="agenda-logo-link" href="/">
			<!-- Use absolute URL as requested -->
			<img src="https://www.agendacerto.com.br/agendacerto-white.svg" alt="Agenda Certo" class="agenda-logo"/>
		</a>
		<div class="agenda-actions">
			<a class="agenda-signup-btn" href="https://www.agendacerto.com.br/?origem=blog" target="_blank" rel="noopener noreferrer">
				Visite o Site
			</a>
		</div>
	</div>
</header>

<style>
	.agenda-header {
		background-color: #111827; /* Dark background to contrast the white logo */
		border-bottom: 1px solid rgba(255, 255, 255, 0.1);
		width: 100%;
	}
	.agenda-header-container {
		margin: 0 auto;
		display: flex;
		height: 4rem; /* h-16 */
		max-width: 80rem; /* max-w-7xl */
		align-items: center;
		justify-content: space-between;
		padding-left: 1rem;
		padding-right: 1rem;
	}
	@media (min-width: 640px) {
		.agenda-header-container { padding-left: 1.5rem; padding-right: 1.5rem; }
	}
	@media (min-width: 1024px) {
		.agenda-header-container { padding-left: 2rem; padding-right: 2rem; }
	}
	.agenda-logo-link {
		display: flex;
		align-items: center;
		text-decoration: none;
	}
	.agenda-logo {
		height: 1.75rem; /* h-7 */
		width: auto;
	}
	.agenda-actions {
		display: flex;
		align-items: center;
		gap: 0.5rem; /* gap-2 */
	}
	.agenda-signup-btn {
		white-space: nowrap; /* whitespace-nowrap */
		border-radius: 0.5rem; /* rounded-lg */
		background-color: #ea580c; /* bg-orange-600 */
		padding: 0.5rem 0.875rem; /* px-3.5 py-2 */
		font-size: 0.875rem; /* text-sm */
		font-weight: 600; /* font-semibold */
		color: #ffffff; /* text-white */
		text-decoration: none;
		box-shadow: 0 10px 15px -3px rgba(234, 88, 12, 0.25); /* shadow-lg shadow-orange-600/25 */
		transition: all 0.2s;
	}
	@media (min-width: 640px) {
		.agenda-signup-btn { padding-left: 1rem; padding-right: 1rem; }
	}
	.agenda-signup-btn:hover {
		background-color: #c2410c; /* hover:bg-orange-700 */
		box-shadow: 0 10px 15px -3px rgba(234, 88, 12, 0.4);
	}
</style>
