<!-- Section 1: Portfólio, Contato e Informações -->
<section class="nemex-info-section">
	<div class="nemex-info-container">
		<div class="nemex-info-grid">
			<div class="nemex-brand-col">
				<img alt="Nemex" class="nemex-brand-img" src="/nemex-ico-negative.png" />
				<p class="nemex-brand-tagline">Construindo o futuro digital, um produto de cada vez.</p>
			</div>
			<div class="nemex-nav-col">
				<p class="nemex-col-title">Portfólio</p>
				<ul class="nemex-link-list">
					<li><a href="https://www.viabonus.com.br/?origem=blog" target="_blank" rel="noopener noreferrer" class="nemex-col-link">Via Bônus</a></li>
					<li><a href="https://jorna.com.br/?origem=blog" target="_blank" rel="noopener noreferrer" class="nemex-col-link">Jorna</a></li>
					<li><a href="https://voltapix.com.br/?origem=blog" target="_blank" rel="noopener noreferrer" class="nemex-col-link">VoltaPix</a></li>
					<li><a href="https://linhasegura.com.br/?origem=blog" target="_blank" rel="noopener noreferrer" class="nemex-col-link">Linha Segura</a></li>
					<li><a href="https://www.agendacerto.com.br/?origem=blog" target="_blank" rel="noopener noreferrer" class="nemex-col-link">Agenda Certo</a></li>
				</ul>
			</div>
			<div class="nemex-nav-col">
				<p class="nemex-col-title">Contato</p>
				<div class="nemex-contact-box">
					<a href="https://wa.me/5511920914201?text=Oi.%20Estou%20entrando%20em%20contato%20para%20fazer%20meu%20site." target="_blank" rel="noopener noreferrer" class="nemex-col-link block">WhatsApp</a>
					<p class="nemex-location">São Paulo, Brasil</p>
				</div>
			</div>
		</div>
	</div>
</section>

<!-- Section 2: Copyright & Links Legais -->
