---
const today = new Date();
---

<!-- Section 1: Portfólio, Contato e Informações -->
<section class="nemex-info-section">
	<div class="nemex-info-container">
		<div class="nemex-info-grid">
			<div class="nemex-brand-col">
				<img alt="Nemex" class="nemex-brand-img" src="/nemex-ico-negative.png" />
				<p class="nemex-brand-tagline">Construindo o futuro digital, um produto de cada vez.</p>
				<div class="nemex-social">
					<a href="https://www.nemex.com.br" target="_blank" rel="noopener noreferrer" aria-label="Site" title="Site" class="nemex-social-icon">
						<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"></path><path d="M2 12h20"></path></svg>
