---
// Nemex CTA Section
---

<section class="ac-cta-section">
	<div aria-hidden="true" class="ac-cta-glow"></div>
	<div aria-hidden="true" class="ac-cta-grain"></div>
	<div class="ac-cta-container">
		<div>
			<h2 class="ac-cta-heading">
				Contrate seu site <span class="ac-cta-highlight">agora.</span>
			</h2>
			<p class="ac-cta-subheading">
				Modernize a presença digital da sua empresa com design exclusivo, alta performance e suporte real.
			</p>
			<div class="ac-cta-actions">
				<a class="ac-cta-btn-primary group" href="https://wa.me/5511920914201?text=Oi.%20Vim%20pelo%20Blog%20da%20Nemex%20e%20gostaria%20de%20saber%20mais%20sobre%20criação%20de%20sites." target="_blank" rel="noopener noreferrer">
					<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-message-circle w-5 h-5" aria-hidden="true"><path d="M2.992 16.342a2 2 0 0 1 .094 1.167l-1.065 3.29a1 1 0 0 0 1.236 1.168l3.413-.998a2 2 0 0 1 1.099.092 10 10 0 1 0-4.777-4.719"></path></svg>
					Chamar no WhatsApp
				</a>
			</div>
		</div>
	</div>
</section>

<style>
	.ac-cta-section {
		position: relative;
		overflow: hidden;
		background-color: #050505; /* Nemex dark bg */
		padding: 7rem 0; /* py-28 */
	}
	@media (min-width: 640px) {
		.ac-cta-section {
			padding: 9rem 0; /* sm:py-36 */
		}
	}

	.ac-cta-glow {
		pointer-events: none;
		position: absolute;
		left: 50%;
		top: 50%;
		height: 500px;
		width: 900px;
		transform: translate(-50%, -50%);
		border-radius: 9999px;
		background-color: rgba(239, 68, 68, 0.25); /* Nemex red glow */
		filter: blur(130px);
	}

	.ac-cta-grain {
		pointer-events: none;
		position: absolute;
		inset: 0;
		opacity: 0.05;
		mix-blend-mode: overlay;
		/* Assume background image grain if needed, but opacity 0.05 is fine to just keep the glow effect clean */
		background-image: url('data:image/svg+xml;base64,');
	}

	.ac-cta-container {
		position: relative;
		margin: 0 auto;
		max-width: 48rem; /* max-w-3xl */
		padding-left: 1rem;
		padding-right: 1rem;
		text-align: center;
	}
	@media (min-width: 640px) {
		.ac-cta-container {
			padding-left: 1.5rem;
			padding-right: 1.5rem;
		}
	}

	.ac-cta-heading {
		font-size: 2.25rem; /* text-4xl */
		font-weight: 800; /* font-extrabold */
		line-height: 1.1; /* leading-tight */
		letter-spacing: -0.025em; /* tracking-tight */
		color: #ffffff;
		margin: 0;
		text-wrap: balance;
	}
	@media (min-width: 640px) {
		.ac-cta-heading {
			font-size: 3.75rem; /* sm:text-6xl */
		}
	}

	.ac-cta-highlight {
		background-image: linear-gradient(to right, #ef4444, #b91c1c); /* Nemex red gradient */
		-webkit-background-clip: text;
		background-clip: text;
		color: transparent;
	}

	.ac-cta-subheading {
		margin: 1.5rem auto 0; /* mt-6 */
		max-width: 36rem; /* max-w-xl */
		font-size: 1.125rem; /* text-lg */
		line-height: 1.625; /* leading-relaxed */
		color: #94a3b8; /* text-slate-400 */
	}

	.ac-cta-actions {
		margin-top: 2.5rem; /* mt-10 */
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 1rem; /* gap-4 */
	}
	@media (min-width: 640px) {
		.ac-cta-actions {
			flex-direction: row;
		}
	}

	.ac-cta-btn-primary {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem; /* gap-2 */
		border-radius: 0.75rem; /* rounded-xl */
		background-color: #22c55e; /* WhatsApp green */
		padding: 1rem 2.5rem; /* px-10 py-4 */
		font-size: 1rem; /* text-base */
		font-weight: 700; /* font-bold */
		color: #ffffff;
		text-decoration: none;
		box-shadow: 0 20px 25px -5px rgba(34, 197, 94, 0.35), 0 8px 10px -6px rgba(34, 197, 94, 0.35);
		transition: all 0.2s;
	}
	.ac-cta-btn-primary:hover {
		background-color: #16a34a; /* hover:bg-green-600 */
		box-shadow: 0 20px 25px -5px rgba(34, 197, 94, 0.55), 0 8px 10px -6px rgba(34, 197, 94, 0.55);
	}

	.lucide-arrow-right {
		height: 1.25rem; /* h-5 */
		width: 1.25rem; /* w-5 */
		transition: transform 0.2s;
	}
	.ac-cta-btn-primary:hover .lucide-arrow-right {
		transform: translateX(0.25rem); /* group-hover:translate-x-1 */
	}
</style>
