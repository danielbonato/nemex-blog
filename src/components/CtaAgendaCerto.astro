---
// Agenda Certo CTA Section
---

<section class="ac-cta-section">
	<div aria-hidden="true" class="ac-cta-glow"></div>
	<div aria-hidden="true" class="ac-cta-grain"></div>
	<div class="ac-cta-container">
		<div>
			<h2 class="ac-cta-heading">
				Seu próximo cliente quer agendar 
				<span class="ac-cta-highlight"> agora.</span>
			</h2>
			<p class="ac-cta-subheading">
				Crie sua conta gratuita e comece a receber agendamentos hoje. São 30 dias para testar tudo — sem cartão de crédito.
			</p>
			<div class="ac-cta-actions">
				<a class="ac-cta-btn-primary group" href="https://www.agendacerto.com.br/cadastro?origem=blog">
					Criar conta grátis
					<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide-arrow-right" aria-hidden="true">
						<path d="M5 12h14"></path>
						<path d="m12 5 7 7-7 7"></path>
					</svg>
				</a>
			</div>
		</div>
	</div>
</section>

<style>
	.ac-cta-section {
		position: relative;
		overflow: hidden;
		background-color: #030712; /* bg-gray-950 */
		padding: 7rem 0; /* py-28 */
	}
	@media (min-width: 640px) {
		.ac-cta-section {
			padding: 9rem 0; /* sm:py-36 */
		}
	}

	.ac-cta-glow {
		pointer-events: none;
		position: absolute;
		left: 50%;
		top: 50%;
		height: 500px;
		width: 900px;
		transform: translate(-50%, -50%);
		border-radius: 9999px;
		background-color: rgba(234, 88, 12, 0.2); /* bg-orange-600/20 */
		filter: blur(130px);
	}

	.ac-cta-grain {
		pointer-events: none;
		position: absolute;
		inset: 0;
		opacity: 0.05;
		mix-blend-mode: overlay;
		/* Assume background image grain if needed, but opacity 0.05 is fine to just keep the glow effect clean */
		background-image: url('data:image/svg+xml;base64,');
	}

	.ac-cta-container {
		position: relative;
		margin: 0 auto;
		max-width: 48rem; /* max-w-3xl */
		padding-left: 1rem;
		padding-right: 1rem;
		text-align: center;
	}
	@media (min-width: 640px) {
		.ac-cta-container {
			padding-left: 1.5rem;
			padding-right: 1.5rem;
		}
	}

	.ac-cta-heading {
		font-size: 2.25rem; /* text-4xl */
		font-weight: 800; /* font-extrabold */
		line-height: 1.1; /* leading-tight */
		letter-spacing: -0.025em; /* tracking-tight */
		color: #ffffff;
		margin: 0;
		text-wrap: balance;
	}
	@media (min-width: 640px) {
		.ac-cta-heading {
			font-size: 3.75rem; /* sm:text-6xl */
		}
	}

	.ac-cta-highlight {
		background-image: linear-gradient(to right, #f97316, #ea580c); /* from-orange-500 to-orange-600 */
		-webkit-background-clip: text;
		background-clip: text;
		color: transparent;
	}

	.ac-cta-subheading {
		margin: 1.5rem auto 0; /* mt-6 */
		max-width: 36rem; /* max-w-xl */
		font-size: 1.125rem; /* text-lg */
		line-height: 1.625; /* leading-relaxed */
		color: #94a3b8; /* text-slate-400 */
	}

	.ac-cta-actions {
		margin-top: 2.5rem; /* mt-10 */
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 1rem; /* gap-4 */
	}
	@media (min-width: 640px) {
		.ac-cta-actions {
			flex-direction: row;
		}
	}

	.ac-cta-btn-primary {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem; /* gap-2 */
		border-radius: 0.75rem; /* rounded-xl */
		background-color: #ea580c; /* bg-orange-600 */
		padding: 1rem 2.5rem; /* px-10 py-4 */
		font-size: 1rem; /* text-base */
		font-weight: 700; /* font-bold */
		color: #ffffff;
		text-decoration: none;
		box-shadow: 0 20px 25px -5px rgba(234, 88, 12, 0.3), 0 8px 10px -6px rgba(234, 88, 12, 0.3); /* shadow-xl shadow-orange-600/30 */
		transition: all 0.2s;
	}
	.ac-cta-btn-primary:hover {
		background-color: #c2410c; /* hover:bg-orange-700 */
		box-shadow: 0 20px 25px -5px rgba(234, 88, 12, 0.5), 0 8px 10px -6px rgba(234, 88, 12, 0.5); /* hover:shadow-orange-600/50 */
	}

	.lucide-arrow-right {
		height: 1.25rem; /* h-5 */
		width: 1.25rem; /* w-5 */
		transition: transform 0.2s;
	}
	.ac-cta-btn-primary:hover .lucide-arrow-right {
		transform: translateX(0.25rem); /* group-hover:translate-x-1 */
	}
</style>
